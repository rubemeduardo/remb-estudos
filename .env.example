NODE_ENV=production
PORT=8081

# Use DATABASE_URL em hospedagens gerenciadas, ou preencha DB_* em ambiente local.
DATABASE_URL=
DB_USER=postgres
DB_HOST=localhost
DB_NAME=remb_estudos
DB_PASS=troque_esta_senha
DB_PORT=5432
DB_SSL=false

# Primeiro administrador. O servidor cria este usuário apenas se ele ainda não existir.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque_esta_senha_com_12_ou_mais_caracteres
ADMIN_RESET_PASSWORD=false
